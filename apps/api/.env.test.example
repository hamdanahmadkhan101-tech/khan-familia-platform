# Legacy .env.test files are not loaded by the test runner.
# Use shell variables only when intentionally overriding the local test services.
# Both database and username must be khan_familia_test on a loopback host.
TEST_DATABASE_URL=postgresql://khan_familia_test:khan_familia_test@127.0.0.1:55432/khan_familia_test
TEST_REDIS_PORT=56379

# Optional explicit opt-out. Integration and migration commands fail when false.
# RUN_DB_TESTS=false

# Application DATABASE_URL and all provider credentials are supplied by the runner.
# TEST_DATABASE_CONFIRM is no longer supported as a bypass.
