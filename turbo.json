{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": [".env"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [".env", ".env.*"],
      "outputs": ["dist/**", ".next/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "outputs": []
    },
    "@khan-familia/config#build": {
      "dependsOn": [],
      "outputs": []
    },
    "@khan-familia/database#build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "prisma/schema.prisma", "prisma.config.ts"],
      "outputs": ["dist/**", "node_modules/.prisma/client/**", "node_modules/@prisma/client/**"]
    }
  }
}
