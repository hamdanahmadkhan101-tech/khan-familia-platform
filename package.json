{
  "name": "khan-familia-platform",
  "private": true,
  "packageManager": "pnpm@9.15.1",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=9"
  },
  "scripts": {
    "postinstall": "pnpm --filter @khan-familia/database generate",
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "lint:deps": "syncpack lint",
    "fix:deps": "syncpack fix",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rimraf node_modules .turbo && rimraf **/node_modules **/.turbo **/dist **/.next",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix"
    ],
    "*.{js,jsx,ts,tsx,json,md,mdx,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "15.5.18",
    "@types/node": "22.19.19",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "syncpack": "^15.3.2",
    "turbo": "2.9.14",
    "typescript": "5.9.3",
    "vitest": "^2.1.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@prisma/client",
      "@prisma/engines",
      "prisma"
    ],
    "overrides": {
      "typescript": "5.9.3",
      "@types/node": "22.19.19",
      "zod": "^3.24.1",
      "date-fns": "^3.6.0",
      "react-hook-form": "^7.76.0",
      "@hookform/resolvers": "^5.5.7"
    }
  },
  "version": "0.0.0"
}
