{
  "name": "khan-familia-platform",
  "private": true,
  "packageManager": "pnpm@9.15.1",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rimraf node_modules .turbo && rimraf **/node_modules **/.turbo **/dist **/.next",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix"
    ],
    "*.{js,jsx,ts,tsx,json,md,mdx,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@next/eslint-plugin-next": "15.5.18",
    "@types/node": "22.19.19",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "globals": "^15.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "rimraf": "^6.0.0",
    "syncpack": "^15.3.2",
    "turbo": "2.9.14",
    "typescript": "5.9.3",
    "vitest": "^2.0.0"
  },
  "pnpm": {
    "overrides": {
      "typescript": "5.9.3",
      "@types/node": "22.19.19"
    }
  }
}
